# Copy to .env and adjust as needed. All variables are prefixed to avoid
# colliding with other services' generic PORT env vars on this machine.

AUDIO_SERVER_PORT=8000
AUDIO_SERVER_FRONTEND_PORT=3000

# S3-compatible object storage (MinIO locally, AWS S3 in production).
AUDIO_SERVER_S3_ENDPOINT_URL=http://localhost:9000
AUDIO_SERVER_S3_ACCESS_KEY=minioadmin
AUDIO_SERVER_S3_SECRET_KEY=minioadmin
AUDIO_SERVER_S3_BUCKET_NAME=audio-files
AUDIO_SERVER_S3_REGION=us-east-1

AUDIO_SERVER_DB_PORT=5432
AUDIO_SERVER_DB_USER=postgres
AUDIO_SERVER_DB_PASSWORD=postgres_pwd
AUDIO_SERVER_DB_NAME=audio-server-db
